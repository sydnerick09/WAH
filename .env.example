# ─────────────────────────────────────────────────────────────────────────────
# Business/Gweno Hub — environment variables (placeholders).
# Set the real values in Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App / admin ──
ADMIN_SECRET=
SESSION_SECRET=                        # optional; used to sign session/reset tokens
NEXT_PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app
PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app

# ── Email delivery (Resend preferred; Namecheap SMTP fallback) ──
# Configure RESEND_API_KEY only after verifying your sending domain in Resend.
# SMTP is used automatically if Resend is absent or its API call fails.
RESEND_API_KEY=
EMAIL_FROM_NAME=Gweno Hub
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=management@gweno.business
SMTP_PASS=
# Your only actual Namecheap mailbox is management@gweno.business; the other addresses are aliases.
# Use the management mailbox credentials for SMTP authentication. The category-specific *_EMAIL
# variables below choose the visible From address; they are not separate SMTP logins or passwords.
# Namecheap must permit the management mailbox to send using each alias as the From address.
# Test each sender. If Namecheap rejects or rewrites an alias, use a real mailbox or a provider that
# supports verified sender identities. If using Resend, verify gweno.business and authorize each From address.
NOTIFY_EMAIL=gweno_admin@gweno.business
ADMIN_EMAIL=gweno_admin@gweno.business
SUPPORT_EMAIL=gweno_support@gweno.business
HELP_EMAIL=gweno_help@gweno.business
NOREPLY_EMAIL=gweno_noreply@gweno.business
PROMOTIONAL_EMAIL=gweno_promotions@gweno.business
SUBSCRIPTIONS_EMAIL=gweno_subscriptions@gweno.business
WITHDRAWALS_EMAIL=gweno_withdrawals@gweno.business