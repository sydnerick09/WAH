# ─────────────────────────────────────────────────────────────────────────────
# Business/Gweno Hub — environment variables (placeholders).
# Set the real values in Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App / admin ──
ADMIN_SECRET=
SESSION_SECRET=                        # optional; used to sign session/reset tokens
NEXT_PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app
PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app

# ── Email delivery (Namecheap Private Email SMTP only) ──
# SMTP login is the real mailbox; sender-role addresses below are aliases.
# The domain provider must permit sending as each configured alias.
EMAIL_FROM_NAME=Gweno Hub
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=management@gweno.business
SMTP_PASS=
# management@gweno.business is the SMTP login mailbox. Other addresses are aliases used as From.
# Use the management mailbox password in SMTP_PASS. Do not set SMTP_USER_* or SMTP_PASS_* alias logins.
# Namecheap must permit sending as each alias; if it rejects one, use management as that sender or
# create a real mailbox for that role. SPF, DKIM and DMARC must also be configured in DNS for deliverability.
NOTIFY_EMAIL=gweno_admin@gweno.business
ADMIN_EMAIL=gweno_admin@gweno.business
SUPPORT_EMAIL=gweno_support@gweno.business
HELP_EMAIL=gweno_help@gweno.business
NOREPLY_EMAIL=gweno_noreply@gweno.business
PROMOTIONAL_EMAIL=gweno_promotions@gweno.business
SUBSCRIPTIONS_EMAIL=gweno_subscriptions@gweno.business
WITHDRAWALS_EMAIL=gweno_withdrawals@gweno.business