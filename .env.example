# Gweno Hub — environment variables (placeholders).
# Set real values in Vercel → Project → Settings → Environment Variables.
# Never commit API keys or other secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App / admin
ADMIN_SECRET=
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app
PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app

# Email delivery — Resend API only (no SMTP/Namecheap variables)
RESEND_API_KEY=
# Resend requires this From address to be verified in your Resend account.
# For initial testing, Resend may allow onboarding@resend.dev only to your own account email.
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=Gweno Hub
# Replies and admin notifications go to this Gmail address.
RESEND_REPLY_TO_EMAIL=businesshub.comke@gmail.com
NOTIFY_EMAIL=businesshub.comke@gmail.com
ADMIN_EMAIL=businesshub.comke@gmail.com
