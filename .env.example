# ─────────────────────────────────────────────────────────────────────────────
# Business/Gweno Hub — environment variables (placeholders).
# Set the real values in Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App / admin ──
ADMIN_SECRET=
SESSION_SECRET=                        # optional; used to sign session/reset tokens
NEXT_PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app
PUBLIC_BASE_URL=https://onlinejob-pi.vercel.app

# ── Email (Gmail SMTP) ──
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Safaricom Daraja (M-PESA) — PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────
DARAJA_ENV=production                   # production | sandbox

# App credentials (Daraja portal → your app)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Lipa na M-PESA Online (STK Push, incoming payments) — BUY GOODS (Till) setup.
# For a Till you have TWO numbers: the Store/Head-Office number and the Till.
DARAJA_PASSKEY=                         # the Lipa na M-Pesa Online passkey for the store
DARAJA_SHORTCODE=                       # STORE / Head-Office number (BusinessShortCode; used in the STK password)
DARAJA_TILL=1545320                     # the Till number customers pay to (PartyB)
DARAJA_STK_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# B2C (outgoing customer payouts / withdrawals)
DARAJA_B2C_SHORTCODE=                    # defaults to DARAJA_SHORTCODE if unset
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=             # encrypted initiator password (from the Daraja portal)
DARAJA_B2C_COMMAND_ID=BusinessPayment   # BusinessPayment | SalaryPayment | PromotionPayment

# Callbacks
DARAJA_CALLBACK_BASE_URL=https://onlinejob-pi.vercel.app   # defaults to NEXT_PUBLIC_BASE_URL
DARAJA_CALLBACK_SECRET=                 # random string; appended to callback URLs to authenticate them
