# Gweno Hub — environment variables (placeholders).
# Set real values in Vercel → Project → Settings → Environment Variables.
# Never commit API keys or other secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App / admin
ADMIN_SECRET=
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=https://gweno.business

# Safaricom Daraja configuration (use real production credentials in Vercel).
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_TILL=
DARAJA_STK_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# The application appends /api/mpesa/stk-callback to this public base URL.
DARAJA_CALLBACK_BASE_URL=https://gweno.business
# Optional shared callback secret. If set, it is appended to the callback URL.
DARAJA_CALLBACK_SECRET=
PUBLIC_BASE_URL=https://gweno.business

# Safaricom Daraja configuration (use real production credentials in Vercel).
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_TILL=
DARAJA_STK_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# The application appends /api/mpesa/stk-callback to this public base URL.
DARAJA_CALLBACK_BASE_URL=https://gweno.business
# Optional shared callback secret. If set, it is appended to the callback URL.
DARAJA_CALLBACK_SECRET=

# Email delivery — Gmail SMTP only. Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=businesshub.comke@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=businesshub.comke@gmail.com
SMTP_REPLY_TO_EMAIL=businesshub.comke@gmail.com
EMAIL_FROM_NAME=GWENO Hub
NOTIFY_EMAIL=businesshub.comke@gmail.com
ADMIN_EMAIL=businesshub.comke@gmail.com
