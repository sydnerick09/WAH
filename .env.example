# Gweno Hub — environment variables (placeholders).
# Set real values in Vercel → Project → Settings → Environment Variables.
# Never commit API keys or other secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App / admin
ADMIN_SECRET=
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=https://gweno.business
PUBLIC_BASE_URL=https://gweno.business

# Email delivery — Gmail SMTP only. Use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=businesshub.comke@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=businesshub.comke@gmail.com
SMTP_REPLY_TO_EMAIL=businesshub.comke@gmail.com
EMAIL_FROM_NAME=GWENO Hub
NOTIFY_EMAIL=businesshub.comke@gmail.com
ADMIN_EMAIL=businesshub.comke@gmail.com
